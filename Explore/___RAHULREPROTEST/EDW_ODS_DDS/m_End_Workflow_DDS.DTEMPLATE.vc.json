          "typeSystem" : "Oracle",
          "useDynamicFileName" : "false",
          "object" : {
            "customQuery" : "SELECT   A.WKF_EXEC_ID AS WKF_EXEC_ID,\nSUM(CASE WHEN B.SESS_EXEC_ST != '$$SESS_SUCCEEDED_STATUS' THEN 1 ELSE 0 END) AS NOT_SUCCEEDED\nFROM WKF_EXEC A, SESS_EXEC B, WKF_MASTER C\nWHERE\nC.WKF_ID = A.WKF_ID AND\nA.WKF_EXEC_ID = B.WKF_EXEC_ID AND\nUPPER(C.WKF_CD) = upper('$$PMWorkflowRunInstanceName') AND\n a.wkf_exec_st='$$WKF_STARTED_STATUS'\nGROUP BY \tA.WKF_EXEC_ID",
