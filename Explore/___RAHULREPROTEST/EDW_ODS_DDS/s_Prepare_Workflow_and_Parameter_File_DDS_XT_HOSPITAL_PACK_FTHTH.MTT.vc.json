      "customQuery" : "SELECT WKF_MASTER.WKF_ID, SESS_MASTER.SESS_ID, SESS_PARM.PARM_CD, SESS_PARM.PARM_VAL, WKF_EXEC.WKF_EXEC_ID, SESS_MASTER.SESS_CD, SESS_EXEC.SESS_EXEC_ID, WKF_MASTER.WKF_FLD\nFROM\n SESS_PARM, SESS_MASTER, SESS_EXEC, WKF_EXEC ,WKF_MASTER\nWHERE\nWKF_MASTER.WKF_ID = WKF_EXEC.WKF_ID\nAND SESS_EXEC.WKF_EXEC_ID = WKF_EXEC.WKF_EXEC_ID\nAND WKF_MASTER.WKF_ID = SESS_MASTER.wkf_ID\nAND SESS_MASTER.SESS_ID = SESS_EXEC.SESS_ID\nAND SESS_PARM.SESS_ID = SESS_MASTER.SESS_ID\nAND upper(WKF_MASTER.WKF_CD) =  upper('$$PMWorkflowRunInstanceName')\nAND WKF_EXEC.WKF_EXEC_ST = '$$WKF_STARTED_STATUS'\nAND  TO_CHAR(WKF_EXEC.WKF_EXEC_STRT_TMS,'YYYY-MM-DD HH24:MI:SS') ='$$$SESSSTARTTIME'\n\nUnion \nSELECT WKF_MASTER.WKF_ID,SESS_MASTER.SESS_ID, \nSESS_PARM.PARM_CD, \nSESS_PARM.PARM_VAL, \nNull, \nSESS_MASTER.SESS_CD, \nnull,\nWKF_MASTER.WKF_FLD\nFROM\nSESS_PARM, SESS_MASTER, WKF_MASTER\nwhere \nWKF_MASTER.WKF_ID = SESS_MASTER.wkf_ID\nAND SESS_PARM.SESS_ID = SESS_MASTER.SESS_ID\nAND WKF_MASTER.WKF_CD = '$$GLOBAL_WF_NAME'",
