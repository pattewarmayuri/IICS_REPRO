      "customFuncCfg" : { },
      "customQuery" : "SELECT B.SESS_ID AS SESS_ID\n,  C.WKF_EXEC_ID AS WKF_EXEC_ID\nFROM wkf_master A\ninner join sess_master B  ON  A.WKF_ID = B.WKF_ID \ninner join WKF_EXEC C  on A.WKF_ID = C.WKF_ID\nwhere\nC.WKF_EXEC_ST = '$$WKF_STARTED_STATUS' and\n  TO_CHAR(C.WKF_EXEC_STRT_TMS,'YYYY-MM-DD HH24:MI:SS') ='$$$SESSSTARTTIME' AND upper( A.WKF_CD) = upper('$$PMWorkflowRunInstanceName')",
