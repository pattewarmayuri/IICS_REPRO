      "customQuery" : "SELECT A.WKF_ID AS WKF_ID,\n\tMAX(B.WKF_EXEC_ID) AS WKF_EXEC_ID_PREV\nFROM WKF_MASTER A\nLEFT OUTER JOIN WKF_EXEC B ON\n\tA.WKF_ID = B.WKF_ID AND\n\tB.WKF_EXEC_ST = '$$WKF_SUCCEEDED_STATUS'\nWHERE upper(A.WKF_CD) =  upper('$$PMWorkflowRunInstanceName')\nGROUP BY A.WKF_ID",
